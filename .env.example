# ForgeKit environment configuration (copy to .env.local)
# v0.1 runs entirely without required secrets — everything below is optional.

# ---- App ----
# Public base URL of your deployment (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Future: hosted service (Phase 2+) ----
# Supabase (auth + Postgres) — https://supabase.com
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Redis (job queue / rate limiting) — used only when running the worker stack
# REDIS_URL=redis://localhost:6379

# Razorpay (₹10 lifetime unlock) — server-side keys only, never expose to the client
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
